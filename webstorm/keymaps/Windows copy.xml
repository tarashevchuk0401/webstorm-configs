<keymap version="1" name="Windows copy" parent="$default">
  <action id="ActivateTerminalToolWindow">
    <keyboard-shortcut first-keystroke="alt f12" />
    <keyboard-shortcut first-keystroke="alt back_quote" />
  </action>
  <action id="Back">
    <mouse-shortcut keystroke="button4" />
    <keyboard-shortcut first-keystroke="alt left" />
  </action>
  <action id="CloseContent">
    <keyboard-shortcut first-keystroke="ctrl f4" />
    <keyboard-shortcut first-keystroke="ctrl w" />
  </action>
  <action id="EditorSelectWord" />
  <action id="Forward">
    <mouse-shortcut keystroke="button5" />
    <keyboard-shortcut first-keystroke="alt right" />
  </action>
  <action id="NextTab">
    <keyboard-shortcut first-keystroke="ctrl alt right" />
  </action>
  <action id="PreviousTab">
    <keyboard-shortcut first-keystroke="ctrl alt left" />
  </action>
  <action id="ReformatWithPrettierAction">
    <keyboard-shortcut first-keystroke="shift alt f" />
  </action>
  <action id="SmartSelect" />
  <action id="TableResult.GrowSelection" />
  <action id="TableResult.SelectColumn" />
  <action id="Terminal.DeletePreviousWord" />
  <action id="UsageFiltering.WriteAccess" />
  <action id="Vcs.QuickListPopupAction" />
</keymap>